# Copier en .env et adapter
APP_ENV=local
APP_DEBUG=true
# Sous-répertoire d'URL si l'app n'est pas servie à la racine du vhost (ex. /perfectmaint)
APP_BASE_PATH=
SESSION_SECURE=false
# Devise des coûts : USD (défaut), CDF, EUR…
APP_CURRENCY=USD
# Fuseau horaire des sites (dates affichées et enregistrées)
APP_TIMEZONE=Africa/Lubumbashi

# Sauvegardes : dossier des outils MariaDB (mysqldump, mysql) s'ils ne sont pas dans le PATH, dossier des archives,
# copie hors serveur (disque externe ou partage réseau), rétention en jours, âge maximal toléré en heures.
MYSQL_BIN=
BACKUP_DIR=
BACKUP_COPY_DIR=
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_AGE_HOURS=26

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=perfectmaint
DB_USER=perfectmaint
DB_PASS=
